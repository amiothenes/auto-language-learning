# Copy this file to .env.local and fill in your values.

# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# spaCy NLP microservice base URL (production)
NLP_SERVICE_URL=https://your-nlp-service.example.com

# spaCy NLP microservice base URL (local dev)
NLP_SERVICE_URL_LOC=http://localhost:8000

# Admin API key (server-side)
ADMIN_API_KEY=your-admin-api-key

# Admin API key (exposed to browser — must match ADMIN_API_KEY)
NEXT_PUBLIC_ADMIN_API_KEY=your-admin-api-key
