# Copy this file to .env.local and fill in your values.

# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase Auth (get these from your Supabase project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# spaCy NLP microservice base URL (production)
NLP_SERVICE_URL=https://your-nlp-service.example.com

# spaCy NLP microservice base URL (local dev)
NLP_SERVICE_URL_LOC=http://localhost:8000

# NLP service API key
NLP_API_KEY=your-nlp-api-key

# Azure Translator
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure Speech (TTS) — separate resource from Azure Translator, needs its own key/region.
# Only key + region are needed: the Speech SDK's SpeechConfig.fromSubscription()
# resolves the correct endpoint internally, unlike the plain-REST Translator client.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Used by A.5 backfill migration — set to the Supabase Auth UUID of the admin/seed user
SEED_ADMIN_USER_ID=

# Upstash Redis (rate limiting) — REST API, see console.upstash.com
# Safe to leave unset in local dev: rate limiting fails open with no Redis client configured
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
